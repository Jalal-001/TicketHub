<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- ASP.NET Core -->
	<ItemGroup>
		<PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
		<PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
		<PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
	</ItemGroup>

	<!-- EF Core -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.22" />
	</ItemGroup>

	<!-- FluentValidation -->
	<ItemGroup>
		<PackageVersion Include="FluentValidation" Version="12.2.0" />
		<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
	</ItemGroup>

	<!-- Microsoft.Extensions -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.22" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.22" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.22" />
	</ItemGroup>

	<!-- Testing -->
	<ItemGroup>
		<PackageVersion Include="coverlet.collector" Version="6.0.2" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageVersion Include="xunit" Version="2.9.2" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
